# Copy this file to .env and fill in your actual values

# Database Configuration (for development)
DB_HOST=localhost
DB_NAME=elsiebrain
DB_USER=elsie
DB_PASSWORD=elsiexyz
DB_PORT=5432

# AI Configuration - one local Gemma container per engine
OLLAMA_VOICE_URL=http://localhost:11434
OLLAMA_VOICE_MODEL=gemma3:4b
OLLAMA_ATTENTION_URL=http://localhost:11435
OLLAMA_ATTENTION_MODEL=gemma3:4b
OLLAMA_EMOTION_URL=http://localhost:11436
OLLAMA_EMOTION_MODEL=gemma3:1b
OLLAMA_LOGIC_URL=http://localhost:11437
OLLAMA_LOGIC_MODEL=gemma3:1b
OLLAMA_KNOWLEDGE_URL=http://localhost:11438
OLLAMA_KNOWLEDGE_MODEL=gemma3:1b
OLLAMA_WISDOM_URL=http://localhost:11439
OLLAMA_WISDOM_MODEL=gemma3:4b

# Discord Configuration
DISCORD_TOKEN=your_discord_token_here

# Docker Registry (optional - leave empty for local development)
ECR_REGISTRY=

# Note: In production/Docker, DB_HOST should be 'elsiebrain_db' (the service name)
# In development container, the database connection will be handled automatically 